{
  "name": "@architecture/shell-cqrs",
  "version": "2.0.0",
  "description": "CQRS mediator pattern implementation for Universal DDD Architecture",
  "keywords": ["ddd", "cqrs", "mediator", "architecture", "command", "query"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:contract": "jest --testPathPattern=contract",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@architecture/core": "file:../architecture-core",
    "reflect-metadata": "^0.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.0"
  },
  "files": ["dist/**/*", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
