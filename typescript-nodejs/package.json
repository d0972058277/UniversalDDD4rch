{
  "name": "universal-ddd-architecture-typescript",
  "version": "2.0.0",
  "private": true,
  "description": "Universal DDD Architecture - TypeScript/Node.js implementation workspace",
  "workspaces": [
    "architecture-core",
    "architecture-shell-cqrs",
    "architecture-express",
    "architecture-typeorm"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:contract": "npm run test:contract --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "clean": "npm run clean --workspaces",
    "docs": "npm run docs --workspace=architecture-core"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Universal DDD Architecture",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/universal-ddd/architecture.git",
    "directory": "typescript-nodejs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
