<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="../Directory.Build.props" />

  <!-- Test-specific overrides -->
  <PropertyGroup>
    <!-- Disable analyzer rules for test projects that are too strict -->
    <NoWarn>$(NoWarn);CA1852;CA2007;CA1707;CA1062;CA1034;CA1724;CA1303;CA1819;CA1002;CA1024;CA1822;CA1506;CA1502;CA2201;CA1063;CA1816;CA1032;CA1305;CA1801;CA1825;CA1031;CA1715;CA1720;CA1711;CA1710;CA1008;CA1717;CA1716;CA1307;CA1308;CA1304;CA1310;CA1812;CA1028;CA1027;CA1200;CA1721;CA1815;CA1724;CA1056;CA1055;CA1054;CA1051;CA1052;CA1050;CA1049;CA1047;CA1046;CA1045;CA1044;CA1043;CA1041;CA1040;CA1036;CA1035;CA1033;CA1030;CA1029;CA1026;CA1025;CA1023;CA1021;CA1020;CA1019;CA1018;CA1017;CA1016;CA1014;CA1013;CA1012;CA1011;CA1010;CA1009;CA1007;CA1006;CA1005;CA1004;CA1003;CA1001;CA1508;CA2225;CA1861;CA1849</NoWarn>

    <!-- Less strict nullable checking for test code -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>